<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>com.github.armaaar.CosmicExtAppletRotation</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-only</project_license>
  <name>Screen Rotation</name>
  <summary>Automatic screen rotation for the COSMIC™ desktop</summary>
  <description>
    <p>
      A panel applet that automatically rotates the screen based on
      accelerometer readings. Designed for convertible laptops and tablets
      running the COSMIC™ desktop.
    </p>
    <p>Features:</p>
    <ul>
      <li>Automatic rotation detection via iio-sensor-proxy</li>
      <li>Toggle to lock or unlock rotation from the system panel</li>
      <li>Support for all four orientations (normal, left, right, upside-down)</li>
    </ul>
  </description>
  <developer id="com.github.armaaar">
    <name>armaaar</name>
  </developer>
  <url type="homepage">https://github.com/armaaar/cosmic-ext-applet-rotation</url>
  <url type="bugtracker">https://github.com/armaaar/cosmic-ext-applet-rotation/issues</url>
  <url type="vcs-browser">https://github.com/armaaar/cosmic-ext-applet-rotation</url>
  <launchable type="desktop-id">com.github.armaaar.CosmicExtAppletRotation.desktop</launchable>
  <screenshots>
    <screenshot type="default">
      <caption>Rotation applet enabled in the panel</caption>
      <image>https://raw.githubusercontent.com/armaaar/cosmic-ext-applet-rotation/main/resources/screenshots/applet-enabled.png</image>
    </screenshot>
    <screenshot>
      <caption>Rotation applet disabled in the panel</caption>
      <image>https://raw.githubusercontent.com/armaaar/cosmic-ext-applet-rotation/main/resources/screenshots/applet-disabled.png</image>
    </screenshot>
    <screenshot>
      <caption>Automatic screen rotation demo</caption>
      <image>https://raw.githubusercontent.com/armaaar/cosmic-ext-applet-rotation/main/resources/screenshots/demo.gif</image>
    </screenshot>
  </screenshots>
  <content_rating type="oars-1.1" />
  <releases>
    <release version="0.2.0" date="2026-10-26">
      <description>
        <p>Renamed to cosmic-ext-applet-rotation with the app ID com.github.armaaar.CosmicExtAppletRotation, following the COSMIC trademark policy for third-party applets. Auto-rotate settings saved by 0.1.0 are not carried over.</p>
      </description>
    </release>
    <release version="0.1.0" date="2026-03-24">
      <description>
        <p>Initial release with automatic screen rotation support.</p>
      </description>
    </release>
  </releases>
  <requires>
    <display_length compare="ge">360</display_length>
  </requires>
  <supports>
    <control>pointing</control>
    <control>touch</control>
  </supports>
</component>
